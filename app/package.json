    "expo-router": "56.2.21",
    "expo-sharing": "56.0.26",
    "expo-sqlite": "56.0.6",
    "expo-status-bar": "56.0.4",
    "lucide-react-native": "1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
